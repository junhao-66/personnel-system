<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.personnel.mapper.AttendanceRuleMapper">
    <select id="selectForUpdate" resultType="com.personnel.entity.AttendanceRuleDO">
        SELECT id, enterprise_id, work_start_time, work_end_time
        FROM attendance_rule WHERE id = 1 FOR UPDATE
    </select>
</mapper>
