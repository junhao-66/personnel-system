{
  "name": "personnel-system-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --config .prettierrc.json --write \"src/**/*.{vue,ts,scss}\" \"../backend/src/main/java/**/*.java\"",
    "format:check": "prettier --config .prettierrc.json --check \"src/**/*.{vue,ts,scss}\" \"../backend/src/main/java/**/*.java\"",
    "standards:check": "node ../tools/check_code_standards.cjs",
    "check": "npm run format:check && npm run standards:check && npm run type-check"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "element-plus": "^2.8.8",
    "pinia": "^2.2.6",
    "three": "^0.181.0",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "3.6.2",
    "prettier-plugin-java": "2.7.1",
    "sass": "^1.80.6",
    "typescript": "~5.6.3",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10"
  }
}
